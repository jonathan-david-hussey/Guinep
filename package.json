{
  "name": "guinep",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"**/*.{js,json,md,ts,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,ts,yaml,yml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npm run lint:eslint && npm run lint:oxlint",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:oxlint": "oxlint src/ test/ --type-aware --deny-warnings",
    "prepare": "git config core.hooksPath .githooks",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run security:audit && npm run build && npm run test:cov && npm run test:e2e",
    "security:audit": "npm audit --audit-level=low",
    "security:corpus": "npm run build && node scripts/security-corpus-runner.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "jscpd": "^5.0.16",
    "knip": "^6.33.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.2"
  }
}
